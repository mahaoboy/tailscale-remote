<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <Space
        android:layout_width="match_parent"
        android:layout_height="48dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="服务器地址"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/editServerUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="wss://100.68.64.94:8765/phone"
        android:inputType="textUri"
        android:text="wss://100.68.64.94:8765/phone"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnConnect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="连接"
        android:layout_marginBottom="4dp" />

    <Button
        android:id="@+id/btnDisconnect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="断开"
        android:enabled="false"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/txtStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="未连接"
        android:textSize="14sp"
        android:textColor="#888888"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/txtA11yHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚠️ 请在 设置→无障碍 中启用「远程控制」服务"
        android:textSize="12sp"
        android:textColor="#CC0000"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/txtShizukuHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Shizuku 未运行"
        android:textSize="12sp"
        android:textColor="#CC0000" />

    <Button
        android:id="@+id/btnShizuku"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="如何启用 Shizuku"
        android:layout_marginBottom="8dp" />

    <CheckBox
        android:id="@+id/chkDanger"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="允许危险命令（shell / 授权限 / 改系统设置）"
        android:textSize="12sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="默认关闭。开启后远程可执行任意 shell；卸载其他应用、重启关机、删除文件、清应用数据永远被拦截。"
        android:textSize="10sp"
        android:textColor="#999999"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/txtLog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="8"
        android:ellipsize="end"
        android:text="日志:"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:background="#F0F0F0"
        android:padding="4dp"
        android:scrollbars="vertical"
        android:textIsSelectable="true"
        android:gravity="bottom" />

</LinearLayout>
